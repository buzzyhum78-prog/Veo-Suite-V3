# =============================================================================
# Veo Suite V3 — environment variables (template)
# =============================================================================
# Sao chép file này thành `.env` rồi điền giá trị thực tế.
# KHÔNG commit `.env` vào git (đã được .gitignore).
#
# Các giá trị môi trường này có độ ưu tiên CAO HƠN giá trị trong
# `VeoSuite_V3/config/ai_registry.json` (ngoại trừ key truyền trực tiếp
# qua tham số trong code).

# -----------------------------------------------------------------------------
# Hệ thống
# -----------------------------------------------------------------------------
# Đường dẫn tới ffmpeg binary (để trống nếu đã có trong PATH)
FFMPEG_PATH=

# -----------------------------------------------------------------------------
# Stock media providers
# -----------------------------------------------------------------------------
# https://www.pexels.com/api/
PEXELS_API_KEY=

# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# -----------------------------------------------------------------------------
# AI / LLM providers
# -----------------------------------------------------------------------------
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Image generation
# -----------------------------------------------------------------------------
# Pollinations: free, không cần key (để trống)
POLLINATIONS_API_KEY=

# Stability AI / DreamStudio (https://platform.stability.ai/)
STABILITY_API_KEY=

# -----------------------------------------------------------------------------
# Voice / TTS providers
# -----------------------------------------------------------------------------
# ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# -----------------------------------------------------------------------------
# Publisher (YouTube upload via OAuth)
# -----------------------------------------------------------------------------
# Đường dẫn file client_secret.json tải từ Google Cloud Console
# (KHÔNG commit file này vào git)
YOUTUBE_CLIENT_SECRET_PATH=

# -----------------------------------------------------------------------------
# Tuỳ chọn nâng cao (chỉ chỉnh khi biết rõ)
# -----------------------------------------------------------------------------
# Bật mã hoá API key tại chỗ (sẽ áp dụng từ PR sau)
# VEO_SECRETS_ENCRYPTION=keyring   # keyring | fernet | none
